/* ========================================
   热门游戏攻略站 — 自定义样式 (含深色模式)
   ======================================== */

/* ===== CSS 变量（主题系统） ===== */
:root {
  --bg-primary: #ffffff;
  --bg-secondary: #f8f9fa;
  --bg-card: #ffffff;
  --bg-code: #282c34;
  --text-primary: #2c3e50;
  --text-secondary: #666;
  --text-muted: #999;
  --border-color: #eaecef;
  --border-light: #f0f0f0;
  --table-stripe: #fafbfc;
  --table-hover: rgba(231, 76, 60, 0.04);
  --shadow-sm: 0 2px 8px rgba(0,0,0,0.06);
  --shadow-md: 0 4px 16px rgba(0,0,0,0.1);
  --shadow-lg: 0 8px 24px rgba(0,0,0,0.12);
  --gradient-nav: linear-gradient(135deg, $accentColor, #e67e22);
  --gradient-h1: linear-gradient(135deg, $textColor, lighten($textColor, 25%));
  --gradient-thead: linear-gradient(135deg, $accentColor, darken($accentColor, 10%));
  --search-shadow: 0 0 0 3px rgba($accentColor, 0.1);
  --img-shadow: 0 4px 12px rgba(0,0,0,0.1);
  --tip-bg: #f0faf6;
  --warning-bg: #fef9e7;
  --danger-bg: #fdedec;
  --navbar-bg: #ffffff;
  --sidebar-bg: #ffffff;
  --hero-text: $textColor;
}

/* ===== 深色主题 ===== */
html[data-theme="dark"] {
  --bg-primary: #1a1a2e;
  --bg-secondary: #16213e;
  --bg-card: #16213e;
  --bg-code: #0d1117;
  --text-primary: #e0e0e0;
  --text-secondary: #b0b0b0;
  --text-muted: #777;
  --border-color: #2a2a4a;
  --border-light: #2a2a4a;
  --table-stripe: rgba(255,255,255,0.03);
  --table-hover: rgba(231, 76, 60, 0.08);
  --shadow-sm: 0 2px 8px rgba(0,0,0,0.3);
  --shadow-md: 0 4px 16px rgba(0,0,0,0.4);
  --shadow-lg: 0 8px 24px rgba(0,0,0,0.5);
  --gradient-h1: linear-gradient(135deg, #e74c3c, #e67e22);
  --search-shadow: 0 0 0 3px rgba($accentColor, 0.25);
  --img-shadow: 0 4px 16px rgba(0,0,0,0.4);
  --tip-bg: rgba(39, 174, 96, 0.12);
  --warning-bg: rgba(243, 156, 18, 0.12);
  --danger-bg: rgba(231, 76, 60, 0.12);
  --navbar-bg: #1a1a2e;
  --sidebar-bg: #1a1a2e;
  --hero-text: #e0e0e0;
}

/* ===== 全局基础 ===== */
body {
  background: var(--bg-primary);
  color: var(--text-primary);
}

.theme-default-content code {
  color: var(--text-primary);
}

/* ===== 导航栏 ===== */
.navbar {
  background: var(--navbar-bg) !important;
  box-shadow: var(--shadow-sm);
  border-bottom: 3px solid $accentColor;
}

.navbar .site-name {
  font-weight: 800;
  letter-spacing: 0.5px;
  background: var(--gradient-nav);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.navbar .links {
  background: var(--navbar-bg) !important;
}

/* 深色模式切换按钮 */
.theme-toggle-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 2px solid var(--border-color);
  background: var(--bg-secondary);
  cursor: pointer;
  font-size: 1.1rem;
  transition: all 0.3s ease;
  margin-left: 8px;
  color: var(--text-primary);
  outline: none;
  vertical-align: middle;
}

.theme-toggle-btn:hover {
  border-color: $accentColor;
  background: rgba($accentColor, 0.1);
  transform: rotate(15deg);
}

/* ===== 首页 ===== */
.home .hero .action-button {
  border-radius: 8px;
  font-weight: 600;
  letter-spacing: 0.3px;
  padding: 0.8rem 2rem;
  transition: all 0.3s ease;
}

.home .hero .action-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba($accentColor, 0.35);
}

.home .hero h1,
.home .hero .description {
  color: var(--hero-text);
}

/* ===== 侧边栏 ===== */
.sidebar {
  background: var(--sidebar-bg) !important;
  box-shadow: 2px 0 12px rgba(0,0,0,0.06);
}

.sidebar-heading {
  font-weight: 700 !important;
  font-size: 0.95rem !important;
  letter-spacing: 0.3px;
  text-transform: uppercase;
  color: $accentColor !important;
}

a.sidebar-link {
  color: var(--text-secondary);
}

a.sidebar-link:hover {
  color: $accentColor;
}

a.sidebar-link.active {
  color: $accentColor !important;
  background: rgba($accentColor, 0.08);
  border-left-color: $accentColor !important;
}

/* ===== 标题 ===== */
h1, h2, h3, h4, h5, h6 {
  font-weight: 700;
  color: var(--text-primary);
}

h1 {
  font-size: 2.2rem;
  background: var(--gradient-h1);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  padding-bottom: 0.5rem;
  margin-bottom: 1.5rem;
}

h2 {
  font-size: 1.6rem;
  padding-bottom: 0.4rem;
  margin-top: 2.5rem;
  border-bottom: 2px solid var(--border-light);
  position: relative;
}

h2:after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 60px;
  height: 2px;
  background: $accentColor;
}

h3 {
  font-size: 1.25rem;
  margin-top: 2rem;
}

/* ===== 提示框 ===== */
.custom-block {
  border-radius: 8px;
  border-left-width: 4px;
  margin: 1.5rem 0;
  padding: 1rem 1.2rem;
}

.custom-block.tip {
  background: var(--tip-bg);
  border-color: $successColor;
}

.custom-block.warning {
  background: var(--warning-bg);
  border-color: $warningColor;
}

.custom-block.danger {
  background: var(--danger-bg);
  border-color: $dangerColor;
}

/* ===== 游戏卡片 ===== */
.game-card {
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 1.5rem;
  margin: 1rem 0;
  transition: all 0.3s ease;
  background: var(--bg-card);
}

.game-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-lg);
  border-color: $accentColor;
}

.game-card h3 {
  margin-top: 0;
  color: $accentColor;
}

/* ===== 评分徽章 ===== */
.score-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  font-size: 1.1rem;
  font-weight: 800;
  color: #fff;
}
.score-green { background: linear-gradient(135deg, #27ae60, #2ecc71); }
.score-blue  { background: linear-gradient(135deg, #2980b9, #3498db); }
.score-gold  { background: linear-gradient(135deg, #f39c12, #f1c40f); color: #333; }
.score-red   { background: linear-gradient(135deg, #e74c3c, #c0392b); }

/* ===== 表格 ===== */
table {
  border-collapse: separate;
  border-spacing: 0;
  width: 100%;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  margin: 1.5rem 0;
}

thead {
  background: var(--gradient-thead);
}

thead th {
  color: #fff !important;
  border: none !important;
  padding: 0.8rem 1rem;
}

tbody td {
  color: var(--text-primary);
  background: var(--bg-card);
}

tbody tr:nth-child(even) td {
  background: var(--table-stripe);
}

tbody tr:hover td {
  background: var(--table-hover);
}

td, th {
  padding: 0.7rem 1rem;
  border: 1px solid var(--border-color);
}

/* ===== 代码块 ===== */
div[class*="language-"] {
  border-radius: 8px;
  box-shadow: var(--shadow-md);
  background: var(--bg-code) !important;
}

div[class*="language-"] pre, div[class*="language-"] code {
  color: #e0e0e0;
}

div[class*="language-"]:before {
  color: rgba(255,255,255,0.5);
  font-weight: 600;
}

/* ===== 页脚 ===== */
.page-edit, .page-nav {
  color: var(--text-secondary);
}

.footer-content {
  text-align: center;
  padding: 2rem 0;
  color: var(--text-muted);
  font-size: 0.9rem;
  border-top: 1px solid var(--border-color);
  margin-top: 4rem;
}

/* ===== 回顶按钮 ===== */
.back-to-top {
  border-radius: 50% !important;
  box-shadow: var(--shadow-sm);
}

/* ===== 响应式 ===== */
@media (max-width: 719px) {
  h1 { font-size: 1.7rem; }
  h2 { font-size: 1.3rem; }
  .home .hero { padding: 2.5rem 1rem 2rem; }
}

/* ===== 进度条 ===== */
#nprogress .bar {
  background: linear-gradient(90deg, $accentColor, #e67e22) !important;
  height: 3px;
}

/* ===== 搜索框 ===== */
.search-box input {
  border-radius: 6px;
  border: 2px solid transparent;
  background: var(--bg-secondary);
  color: var(--text-primary);
  transition: all 0.3s ease;
}

.search-box input:focus {
  border-color: $accentColor;
  box-shadow: var(--search-shadow);
}

.search-box .suggestions {
  background: var(--bg-card);
  border-color: var(--border-color);
}

.search-box .suggestion a {
  color: var(--text-primary);
}

.search-box .suggestion.focused {
  background: rgba($accentColor, 0.1);
}

/* ===== 图片 ===== */
.content img {
  border-radius: 8px;
  box-shadow: var(--img-shadow);
  margin: 1rem auto;
  display: block;
}

/* ===== 正文通用 ===== */
.theme-default-content {
  color: var(--text-primary);
}

.page .theme-default-content p {
  color: var(--text-primary);
}

blockquote {
  background: var(--bg-secondary);
  border-left-color: $accentColor;
  color: var(--text-secondary);
}

hr {
  border-top-color: var(--border-color);
}

/* ===== 滚动条（Webkit） ===== */
::-webkit-scrollbar { width: 8px; }
::-webkit-scrollbar-track { background: var(--bg-secondary); }
::-webkit-scrollbar-thumb {
  background: var(--border-color);
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }

/* ===== 深色模式过渡动画 ===== */
body, .navbar, .sidebar, .game-card, .theme-default-content {
  transition: background 0.3s ease, color 0.3s ease;
}
